# ============================================================================
# 1. ÜCRETSİZ RESMİ YAPAY ZEKA API ANAHTARLARI (Kredi Kartı İstemez - %100 Bedava)
# ============================================================================
# TradingArena.ai 1.'si Llama 4 Maverick ve 2.'si Llama 4 Scout için (30 saniyede Google ile giriş yapıp al):
# Link: https://console.groq.com/keys
GROQ_API_KEY=

# TradingArena.ai 3.'sü Google Gemini Flash için (Google hesabınla tek tıkla bedava al):
# Link: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepSeek R1 / V3 ve Qwen Ücretsiz modelleri için (İsteğe bağlı):
# Link: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# ============================================================================
# 2. BINANCE GERÇEK AL-SAT AYARLARI
# ============================================================================
# ÖNEMLİ: Binance API oluştururken SADECE "Enable Spot & Margin Trading" kutusunu işaretleyin, "Enable Withdrawals (Para Çekme)" kesinlikle KAPALI olsun!
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# LIVE_TRADING=false iken gerçek Binance tahtasındaki (Best Bid / Best Ask) fiyatlarla %100 gerçekçi sanal bakiye (Paper) modunda otomatik al-sat yapar.
# Gerçek Binance hesabınızla al-sat yapması için LIVE_TRADING=true yapın.
LIVE_TRADING=false

# Başlangıç Kasa Ayarı (TL ve USDT karşılığı)
BANKROLL_TRY=1000
BANKROLL_USDT=28.01
MAX_OPEN_POSITIONS=3
ORDER_SIZE_USDT=7.50
SCAN_INTERVAL_SECONDS=45
