# Binance Gerçek Al-Sat Ayarları (Gerçek para ile çalıştırmak için doldurup dosya adını .env yapın)
# ÖNEMLİ: Binance API oluştururken SADECE "Enable Spot & Margin Trading" kutusunu işaretleyin, "Enable Withdrawals (Para Çekme)" kesinlikle KAPALI olsun!
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# LIVE_TRADING=false iken gerçek Binance tahtasındaki (Best Bid / Best Ask) fiyatlarla %100 gerçekçi sanal bakiye (Paper) modunda otomatik al-sat yapar.
# Gerçek Binance hesabınızla al-sat yapması için LIVE_TRADING=true yapın.
LIVE_TRADING=false

# Başlangıç Kasa Ayarı (TL ve USDT karşılığı)
BANKROLL_TRY=1000
BANKROLL_USDT=28.01
MAX_OPEN_POSITIONS=3
ORDER_SIZE_USDT=7.50
SCAN_INTERVAL_SECONDS=45
